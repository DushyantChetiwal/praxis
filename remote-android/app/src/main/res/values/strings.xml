    <!-- Pairing -->
    <string name="pair_title">Pair with %1$s</string>
    <string name="pair_intro">Pairing lets this phone follow and control Praxis on %1$s. Everything they exchange is encrypted with a key only the two of them know.</string>
    <string name="pair_steps">Praxis on the computer will ask whether to allow this phone and show a 6-digit code. You’ll check that it matches the code shown here.</string>
    <string name="pair_phone_name">This phone will appear as “%1$s”.</string>
    <string name="pair_offline">%1$s %2$s. Praxis has to be running there to pair.</string>
    <string name="pair_start">Start pairing</string>
    <string name="pair_start_anyway">Pair anyway</string>
    <string name="pair_waiting">Waiting for Praxis on %1$s…</string>
    <string name="pair_waiting_help">Keep Praxis open on the computer. This request expires in %1$d:%2$02d.</string>
    <string name="pair_code_title">Pairing code</string>
    <string name="pair_code_check">Check that Praxis on %1$s shows the same code, then click Allow there.</string>
    <string name="pair_code_mismatch">If the codes are different, click Deny on the computer and cancel here.</string>
