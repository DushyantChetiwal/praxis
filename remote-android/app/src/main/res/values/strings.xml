    <!-- Sign-in -->
    <string name="signin_tagline">Follow and steer the coding agent on your computer from your phone, end-to-end encrypted.</string>
    <string name="signin_button">Sign in with GitHub</string>
    <string name="signin_explainer">You’ll get a short code to enter on github.com. Sign in with the same GitHub account as Praxis on your computer. There’s no repository to create and nothing to install on GitHub.</string>
    <string name="signin_client_id">GitHub App client ID</string>
    <string name="signin_client_id_help">This build has no client ID built in. Enter the client ID of your “Praxis Remote” GitHub App (it starts with “Iv”). The app needs Device Flow turned on and the account permission Gists: Read and write.</string>
    <string name="signin_client_id_override_help">Leave empty to use the client ID built into this app.</string>
    <string name="signin_advanced">Advanced</string>
    <string name="signin_need_client_id">Enter the GitHub App client ID first.</string>
    <string name="signin_contacting">Contacting GitHub…</string>
    <string name="signin_finishing">Signing in…</string>
    <string name="signin_enter_code">Enter this code on GitHub</string>
    <string name="signin_open_github">Open GitHub</string>
    <string name="signin_code_help">Open %1$s, paste the code and approve Praxis Remote. “Open GitHub” copies the code for you.</string>
    <string name="signin_waiting">Waiting for approval · code expires in %1$d:%2$02d</string>
    <string name="signin_expired">GitHub no longer accepts your sign-in and it couldn’t be renewed (it may have been revoked). Sign in again.</string>

